# ---- Backend (server/) ----
# Required. Never expose to the frontend.
ANTHROPIC_API_KEY=sk-ant-...

# Optional. Defaults shown.
PORT=3001
SIMULATION_MODEL=claude-sonnet-5
EXTRACTION_MODEL=claude-sonnet-5
DEBRIEF_MODEL=claude-opus-5
EQ_PREP_MODEL=claude-opus-5

# Voice mode (OpenAI Realtime). Server only. Without OPENAI_API_KEY, voice mode
# reports "not configured" and text mode keeps working.
OPENAI_API_KEY=your_openai_key_here
OPENAI_VOICE=alloy
# Optional overrides.
# OPENAI_REALTIME_MODEL=gpt-4o-realtime-preview
# OPENAI_REALTIME_URL=wss://api.openai.com/v1/realtime

# Optional. When both are set, sessions persist to Supabase.
# When absent, the server uses an in-memory store (fine for local dev).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional. Comma-separated list of allowed browser origins (production).
CORS_ORIGINS=http://localhost:5173

# ---- Frontend (client/) ----
# Optional. Leave unset in dev (Vite proxies /api to the server).
# In production set to the Railway backend URL, e.g. https://4s-api.up.railway.app
VITE_API_BASE_URL=
